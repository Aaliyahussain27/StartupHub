{
  "name": "startuphub-backend",
  "version": "1.0.0",
  "description": "Backend for StartupHub MVP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "ts-node -e \"process.env.DATABASE_URL && require('./scripts/migrate.ts')\" 2>/dev/null || npx ts-node scripts/migrate.ts",
    "db:migrate:dry": "npx ts-node scripts/migrate.ts -- --dry-run",
    "db:rollback": "npx ts-node scripts/migrate.ts -- --rollback"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jspdf": "^2.5.1",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
